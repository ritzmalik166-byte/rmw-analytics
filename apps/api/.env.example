# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# Number of reverse proxies in front of the API (nginx = 1). Needed for correct client IPs.
TRUST_PROXY=1
# Public URL the tracker script is served from (used in the install snippet)
PUBLIC_API_URL=http://localhost:4100
# Dashboard origin(s), comma separated (CORS + CSRF origin check for the dashboard API)
DASHBOARD_ORIGINS=http://localhost:3100
APP_URL=http://localhost:3100

# ─── Database ───────────────────────────────────────────────────────────────
# Replica set recommended (change streams / transactions); a standalone also works.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=rmw_analytics
MONGODB_POOL_SIZE=50
# Apply collections / indexes / migrations on API start
AUTO_MIGRATE=true

# ─── Redis (optional; required when running more than one API instance) ───
# Enables cross-instance realtime fan-out and shared rate limits.
REDIS_URL=

# ─── Security ───────────────────────────────────────────────────────────────
# 32+ random chars each. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-0000000000
PII_ENCRYPTION_KEY=change-me-to-a-long-random-string-1111111111
IDENTITY_HASH_SECRET=change-me-to-a-long-random-string-2222222222
SESSION_COOKIE_NAME=rmwa_sid
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Allow public self-service sign-up (first user can always register when no users exist)
ALLOW_SIGNUP=false

# ─── Ingestion ──────────────────────────────────────────────────────────────
INGEST_RATE_PER_IP_PER_MIN=1200
INGEST_RATE_PER_SITE_PER_MIN=60000
# Accept tracker requests that carry neither Origin nor Referer (some privacy browsers strip both)
INGEST_ALLOW_MISSING_ORIGIN=true

# ─── Geo (optional) ─────────────────────────────────────────────────────────
# Path to MaxMind GeoLite2-City.mmdb. Without it, CDN headers (Cloudflare / Vercel / CloudFront) are used.
GEOIP_DB_PATH=

# ─── Background jobs ───────────────────────────────────────────────────────
# Run rollups/alerts/reports inside the API process (dev / single instance). Use `npm run worker` in production.
RUN_JOBS_IN_PROCESS=true
ROLLUP_INTERVAL_SECONDS=60

# ─── Email (alerts + scheduled reports; optional) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RMW Analytics <no-reply@example.com>
