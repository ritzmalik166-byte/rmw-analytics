{
  "name": "rmw-analytics-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tracker/build.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node database/src/cli.js migrate",
    "seed": "node src/scripts/seed.js",
    "create-owner": "node src/scripts/createOwner.js",
    "test": "node --test --test-concurrency=1",
    "geoip:update": "node src/scripts/updateGeoip.js"
  },
  "dependencies": {
    "@rmw-analytics/database": "file:./database",
    "@rmw-analytics/shared": "file:./shared",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "isbot": "^5.1.17",
    "mongodb": "^6.10.0",
    "nodemailer": "^6.9.15",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "rrweb": "2.1.7",
    "ua-parser-js": "^1.0.39",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "maxmind": "^4.3.22"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^11.2.2"
  }
}
