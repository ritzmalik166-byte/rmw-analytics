# docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build
# Public origin users and websites reach (dashboard + /tracker.js + /api). Must be HTTPS in production.
PUBLIC_URL=https://analytics.example.com
HTTP_PORT=8080

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PII_ENCRYPTION_KEY encrypts lead data — back it up; losing it makes existing leads unreadable.
SESSION_SECRET=
PII_ENCRYPTION_KEY=
IDENTITY_HASH_SECRET=

COOKIE_SECURE=true
ALLOW_SIGNUP=false
MONGODB_DB=rmw_analytics
MONGO_CACHE_GB=1

# Optional
GEOIP_DB_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RMW Analytics <no-reply@example.com>
LOG_LEVEL=info
